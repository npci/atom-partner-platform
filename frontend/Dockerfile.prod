# ============================================================================
# Partner Frontend — Production Dockerfile (Air-gapped / Nexus Repo)
#
# Uses ${REGISTRY} for all package downloads.
# No internet access required.
#
# Usage:
#   docker build -f Dockerfile.prod -t partner-frontend:prod .
#
# Prerequisites on Nexus (${REGISTRY}):
#   - Docker registry proxy: ${REGISTRY}/docker-hub/
#   - NPM proxy:             ${REGISTRY}/npm-proxy/
# ============================================================================

ARG REGISTRY=docker.io
FROM ${REGISTRY}/docker-hub/node:20-alpine AS builder
WORKDIR /app

# Point NPM to internal Nexus registry.
#
# https, not http: every package tarball for the production bundle was
# previously fetched over an unauthenticated channel. Override the scheme at
# build time if a mirror genuinely has no TLS, so the insecure choice is
# visible in the build command rather than baked in here.
ARG REGISTRY_SCHEME=https
RUN npm config set registry ${REGISTRY_SCHEME}://${REGISTRY}/npm-proxy/

COPY package*.json ./
# `npm ci`, not `npm install`: ci installs package-lock.json exactly and fails
# if the manifest and lock disagree, while `npm install` re-resolves the caret
# ranges at build time. That meant the production image could ship versions
# that were never locked or reviewed — including the `overrides` package.json
# pins for form-data and nanoid, which exist specifically to hold those two at
# remediated versions. CI already uses `npm ci`; the shipped image now matches.
RUN npm ci
COPY . .

# Outbound-link host allowlist for safeUrl.js (DOM XSS and
# open redirect). Vite inlines import.meta.env at BUILD time, so this must be a
# build arg; a runtime env var cannot reach an already-compiled bundle. Unset
# leaves only same-origin links valid, and GitLab MR links render as '#'.
#   docker build -f Dockerfile.prod --build-arg VITE_SAFE_REDIRECT_HOSTS=gitlab.internal .
ARG VITE_SAFE_REDIRECT_HOSTS=""
ENV VITE_SAFE_REDIRECT_HOSTS=$VITE_SAFE_REDIRECT_HOSTS

# GitLab origin used to build merge-request links in the browser. The API no
# longer returns a ready-made MR URL (client DOM XSS, reflected XSS, and
# client DOM open redirect all traced that value into an <a href>); the backend
# sends {project_path, mr_iid} and src/utils/mrUrl.js assembles the address
# against this origin. Build arg for the same Vite reason as above. Unset means
# MR references render as plain text rather than links.
#   docker build -f Dockerfile.prod --build-arg VITE_GITLAB_BASE_URL=https://gitlab.internal .
ARG VITE_GITLAB_BASE_URL=""
ENV VITE_GITLAB_BASE_URL=$VITE_GITLAB_BASE_URL

# Deployment-supplied UI labels; unset -> the neutral defaults in src/strings.js.
# Mirrors the dev Dockerfile's LABEL_PROFILE seam — without it the production
# image could not be re-branded. See the NPCI frontend Dockerfile for why this
# is a file and not a JSON string.
#   docker build -f Dockerfile.prod --build-arg LABEL_PROFILE=labels.upi.json .
ARG LABEL_PROFILE=""

RUN if [ -n "$LABEL_PROFILE" ]; then \
      [ -f "$LABEL_PROFILE" ] || { echo "LABEL_PROFILE $LABEL_PROFILE not found"; exit 1; }; \
      VITE_LABEL_OVERRIDES="$(cat "$LABEL_PROFILE")" npm run build; \
    else npm run build; fi

FROM ${REGISTRY}/docker-hub/nginx:alpine
COPY --from=builder /app/dist /usr/share/nginx/html
COPY nginx.conf.template /etc/nginx/conf.d/default.conf.template
COPY docker-entrypoint.sh /docker-entrypoint.sh
RUN chmod +x /docker-entrypoint.sh
EXPOSE 80
ENTRYPOINT ["/docker-entrypoint.sh"]
