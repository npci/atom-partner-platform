# ============================================================================
# Partner Frontend — Production Dockerfile (Air-gapped / Nexus Repo)
#
# Uses repo.npci.org.in for all package downloads.
# No internet access required.
#
# Usage:
#   docker build -f Dockerfile.prod -t partner-frontend:prod .
#
# Prerequisites on Nexus (repo.npci.org.in):
#   - Docker registry proxy: repo.npci.org.in/docker-hub/
#   - NPM proxy:             repo.npci.org.in/npm-proxy/
# ============================================================================

FROM repo.npci.org.in/docker-hub/node:20-alpine AS builder
WORKDIR /app

# Point NPM to internal Nexus registry
RUN npm config set registry http://repo.npci.org.in/npm-proxy/

COPY package*.json ./
RUN npm install
COPY . .
RUN npm run build

FROM repo.npci.org.in/docker-hub/nginx:alpine
COPY --from=builder /app/dist /usr/share/nginx/html
COPY nginx.conf.template /etc/nginx/conf.d/default.conf.template
COPY docker-entrypoint.sh /docker-entrypoint.sh
RUN chmod +x /docker-entrypoint.sh
EXPOSE 80
ENTRYPOINT ["/docker-entrypoint.sh"]
