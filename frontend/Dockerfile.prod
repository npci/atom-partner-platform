# ============================================================================
# Partner Frontend — Production Dockerfile (Air-gapped / Nexus Repo)
#
# Uses ${REGISTRY} for all package downloads.
# No internet access required.
#
# Usage:
#   docker build -f Dockerfile.prod -t partner-frontend:prod .
#
# Prerequisites on Nexus (${REGISTRY}):
#   - Docker registry proxy: ${REGISTRY}/docker-hub/
#   - NPM proxy:             ${REGISTRY}/npm-proxy/
# ============================================================================

ARG REGISTRY=docker.io
FROM ${REGISTRY}/docker-hub/node:20-alpine AS builder
WORKDIR /app

# Point NPM to internal Nexus registry
RUN npm config set registry http://${REGISTRY}/npm-proxy/

COPY package*.json ./
RUN npm install
COPY . .

# Outbound-link host allowlist for safeUrl.js (Checkmarx #1/#2/#9 — DOM XSS and
# open redirect). Vite inlines import.meta.env at BUILD time, so this must be a
# build arg; a runtime env var cannot reach an already-compiled bundle. Unset
# leaves only same-origin links valid, and GitLab MR links render as '#'.
#   docker build -f Dockerfile.prod --build-arg VITE_SAFE_REDIRECT_HOSTS=gitlab.internal .
ARG VITE_SAFE_REDIRECT_HOSTS=""
ENV VITE_SAFE_REDIRECT_HOSTS=$VITE_SAFE_REDIRECT_HOSTS

# GitLab origin used to build merge-request links in the browser. The API no
# longer returns a ready-made MR URL (Checkmarx: Client DOM XSS, Reflected XSS,
# Client DOM Open Redirect all traced that value into an <a href>); the backend
# sends {project_path, mr_iid} and src/utils/mrUrl.js assembles the address
# against this origin. Build arg for the same Vite reason as above. Unset means
# MR references render as plain text rather than links.
#   docker build -f Dockerfile.prod --build-arg VITE_GITLAB_BASE_URL=https://gitlab.internal .
ARG VITE_GITLAB_BASE_URL=""
ENV VITE_GITLAB_BASE_URL=$VITE_GITLAB_BASE_URL

RUN npm run build

FROM ${REGISTRY}/docker-hub/nginx:alpine
COPY --from=builder /app/dist /usr/share/nginx/html
COPY nginx.conf.template /etc/nginx/conf.d/default.conf.template
COPY docker-entrypoint.sh /docker-entrypoint.sh
RUN chmod +x /docker-entrypoint.sh
EXPOSE 80
ENTRYPOINT ["/docker-entrypoint.sh"]
