# ─────────────────────────────────────────────────────────────────────────────
# Partner platform backend — env template.
#
# Copy to `.env` (gitignored). Runtime operator settings (NPCI URLs, NPCI-issued
# API key / JWT / HMAC secrets) live in the `partner_settings` table, editable
# from the Settings UI. This file carries deployment-level config + secrets that
# do NOT belong in the DB or the agents.yaml manifest.
# ─────────────────────────────────────────────────────────────────────────────

# Display name for this partner instance. Override from Settings UI.
PARTNER_NAME=Partner Agent

# NPCI human-facing URL (used by Settings → Test Connection's reachability
# probe). Direct A2A traffic uses `npci_a2a_url` from partner_settings table.
#
# NOTE: this env var seeds the value only. Test Connection reads the
# `npci_platform_url` row in `partner_settings`, which the Settings UI writes
# and which takes precedence once saved. Changing it here after someone has
# saved it in the UI has no effect — change it in the UI (or clear the row).
NPCI_PLATFORM_URL=https://npci-uat.internal

# Cleartext-URL guard (SAST finding F-001). config.py REFUSES TO START if any
# of npci_platform_url / partner_public_url / ollama_url is http://. Set this to
# true only for local development; leave it out anywhere real credentials flow,
# and use https:// URLs instead.
#
# The three defaults below (host.docker.internal / partner_backend / ollama) are
# docker-compose service names AND cleartext, so a native deployment that copies
# this file unedited will not boot until those URLs are set to reachable https://
# addresses or this flag is enabled.
# PARTNER_ALLOW_HTTP=true

# ── SSRF allowlist for the NPCI connectivity probe ───────────────────────────
# Test Connection refuses to probe a URL that resolves into private address
# space, so admin access cannot be turned into an internal port scanner.
#
# NPCI's UAT and production platforms typically sit on RFC-1918 space, which
# means the probe is blocked until the target is explicitly approved. Name the
# host here (comma-separated, hostname or IP literal) to approve it:
#   NPCI_SSRF_ALLOWED_HOSTS=10.84.12.34,npci-uat.internal
NPCI_SSRF_ALLOWED_HOSTS=

# Blanket permission for private space, when naming each host is impractical.
# Prefer the allowlist above — this opens the entire private range. Loopback and
# link-local (169.254.169.254, the cloud metadata endpoint) remain blocked
# either way; neither flag can re-enable them.
NPCI_SSRF_ALLOW_PRIVATE_NETWORKS=false

# Bootstrap API key NPCI issued for this partner. Once the admin pastes a key
# into Settings UI it overrides this. Leave empty in template.
PARTNER_API_KEY=

# ── Service URLs (defaults are docker-compose service names) ─────────────────
# Both of these default to cleartext http:// on a docker-compose hostname, so a
# NATIVE deployment must set them — otherwise the cleartext guard refuses to
# start, naming URLs that were never in this file.
#
# The address this partner advertises in its AgentCard; NPCI posts JSON-RPC
# (certification envelopes, task payloads) here, so it must be reachable from
# NPCI and https:// wherever real credentials flow.
PARTNER_PUBLIC_URL=https://partner.example.com/a2a-partner
# Local Ollama embedding server. For a native install this is usually
# http://localhost:11434 — which is cleartext, so it needs PARTNER_ALLOW_HTTP=true
# above (acceptable for a loopback-only service).
OLLAMA_URL=http://localhost:11434

# ── Database ─────────────────────────────────────────────────────────────────
# Postgres connection (the standalone compose sets this from PARTNER_POSTGRES_*
# variables). Override here for non-compose deployments — a native install
# normally points at localhost:
# DATABASE_URL=postgresql+psycopg://partner_user:partner_password@localhost:5432/partner_db
# DATABASE_URL=postgresql+psycopg://partner_user:partner_password@partner_postgres:5432/partner_db

# ── Local login-session secret ───────────────────────────────────────────────
# Signs partner-UI login tokens. MUST be set to a strong, unique value per
# deployment. Distinct from the NPCI-issued npci_jwt_secret used for inbound A2A.
#
# Left EMPTY here on purpose. This file gets copied to .env, and a non-empty
# placeholder would satisfy the startup check that exists to catch an unset
# secret — production would then boot happily on a value published in this repo,
# letting anyone forge an admin session token. Empty keeps that check working.
#
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_JWT_SECRET=

# ── Secrets-at-rest encryption key (docs/adr/ADR-0002-secrets-vault-migration.md) ─
# 32-byte AES-256-GCM key-encryption-key (base64), used by core/secret_box.py to
# encrypt npci_jwt_secret / npci_hmac_secret / partner_api_key /
# partner_anthropic_api_key / gitlab_token at rest in partner_settings.
# MUST be set before any secret is saved via Settings — the app will raise on
# first attempt to encrypt/decrypt if this is unset.
# Generate one with:
#   python -c "import secrets,base64; print(base64.b64encode(secrets.token_bytes(32)).decode())"
PARTNER_SECRET_KEK=

# ── A2A ingress fail-closed escape hatch (docs/adr/ADR-0003-fail-closed-a2a-ingress.md) ─
# Dev-only: when true, the A2A ingress accepts unauthenticated calls if
# npci_jwt_secret/npci_hmac_secret are not yet configured. Defaults to false
# (fail-closed). NEVER set this in a production or staging deployment.
PARTNER_ALLOW_UNAUTHENTICATED_A2A=false

# ── Agent framework ──────────────────────────────────────────────────────────
# Path to the agent manifest (impl:/url: bindings + prompts). Defaults to
# <backend>/config/agents.yaml when unset.
AGENTS_CONFIG=/app/config/agents.yaml
# Bearer token sent to remote (`url:`) agents. Only needed if you repoint an
# agent at a bank-hosted service in agents.yaml.
AGENT_SERVICE_TOKEN=

# Path to the capability profile read by the feasibility agent. Ships the blank
# template; point at data/examples/hdfc_profile.md or your own real profile.
PARTNER_PROFILE_PATH=/app/data/partner_profile.md

# ── LLM provider (for in-process agents) ─────────────────────────────────────
# Provider: claude | openai | ainxt. Feasibility returns MOCK output when no key
# is set, so a fresh clone runs without credentials.
LLM_PROVIDER=claude
PARTNER_ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-6
PARTNER_OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
PARTNER_AINXT_API_KEY=
AINXT_BASE_URL=https://gateway.example.com/ainxt/v1/api
AINXT_MODEL=gpt-4o

# Per-change cumulative LLM token budget (design + code plan + codegen + all
# review/fix rounds combined). Exceeding it returns 429 on any further agent
# job for that change until an operator raises the limit or investigates why
# the change isn't converging. 0 = unlimited.
LLM_TOKEN_BUDGET_PER_CHANGE=2000000

# ── Concurrency, scale-in, and single-instance guard (EA_Skills.md P2/P3) ────
# Cross-change agent-job concurrency cap: how many agent jobs may run at once
# across DIFFERENT changes (distinct from the per-change duplicate-dispatch 409
# and the token budget above). Jobs beyond the cap wait this long for a slot,
# then are rejected as "at capacity" rather than queueing unbounded.
AGENTIC_MAX_CONCURRENT_RUNS=5
AGENT_JOB_BULKHEAD_TIMEOUT_S=5.0

# Graceful drain: on shutdown the platform stops accepting new agent jobs and
# waits this long for in-flight ones to finish before marking stragglers.
# Keep <= your orchestrator's termination grace period (Docker
# stop_grace_period / K8s terminationGracePeriodSeconds, both 30s by default) —
# a longer value is cut short by SIGKILL and the drain won't complete.
# 0 disables draining (in-flight jobs die immediately, as before).
SHUTDOWN_DRAIN_TIMEOUT_S=30

# LRU cap on the in-process revision-context cache. Bounded so a long-running
# deployment processing many changes cannot accumulate every change's assembled
# document set in memory.
CONTEXT_CACHE_MAX_ENTRIES=128

# A2A rate limiting and the context cache are PER-PROCESS. Running multiple
# workers/replicas silently multiplies the effective rate limit (each process
# enforces its own window). Startup REFUSES a multi-worker boot unless either
# PARTNER_RATE_LIMIT_REDIS_URL is set (the supported way — see below) or this
# flag explicitly accepts the multiplied limit.
PARTNER_ALLOW_MULTI_WORKER=false

# Shared A2A rate-limit window. Empty = per-process, which is correct for the
# documented single-instance deployment and for forks that do not run redis.
# Set this to make the ingress limit SHARED across workers and replicas: one
# window no matter how many processes hold it. With it set, a multi-worker
# boot is allowed without PARTNER_ALLOW_MULTI_WORKER, because nothing is
# weakened.
#
# Needs the optional `redis` package (`pip install redis`). Without it, or if
# redis is unreachable, the limiter logs a warning and stays per-process —
# it never fails open, and it never blocks startup.
#   PARTNER_RATE_LIMIT_REDIS_URL=redis://redis:6379/0
PARTNER_RATE_LIMIT_REDIS_URL=
