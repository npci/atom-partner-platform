# ─────────────────────────────────────────────────────────────────────────────
# Partner platform backend — env template.
#
# Copy to `.env` (gitignored). Runtime operator settings (NPCI URLs, NPCI-issued
# API key / JWT / HMAC secrets) live in the `partner_settings` table, editable
# from the Settings UI. This file carries deployment-level config + secrets that
# do NOT belong in the DB or the agents.yaml manifest.
# ─────────────────────────────────────────────────────────────────────────────

# Display name for this partner instance. Override from Settings UI.
PARTNER_NAME=Partner Agent

# NPCI human-facing URL (used by Settings → Test Connection's reachability
# probe). Direct A2A traffic uses `npci_a2a_url` from partner_settings table.
NPCI_PLATFORM_URL=http://host.docker.internal

# Bootstrap API key NPCI issued for this partner. Once the admin pastes a key
# into Settings UI it overrides this. Leave empty in template.
PARTNER_API_KEY=

# ── Database ─────────────────────────────────────────────────────────────────
# Postgres connection (the standalone compose runs a `partner_postgres` service).
DATABASE_URL=postgresql+psycopg://partner_user:partner_password@partner_postgres:5432/partner_db

# ── Local login-session secret ───────────────────────────────────────────────
# Signs partner-UI login tokens. MUST be set to a strong, unique value per
# deployment — the app warns loudly if left at the insecure default. Distinct
# from the NPCI-issued npci_jwt_secret used for inbound A2A.
SESSION_JWT_SECRET=CHANGE_ME_INSECURE_DEFAULT

# ── Agent framework ──────────────────────────────────────────────────────────
# Path to the agent manifest (impl:/url: bindings + prompts). Defaults to
# <backend>/config/agents.yaml when unset.
AGENTS_CONFIG=/app/config/agents.yaml
# Bearer token sent to remote (`url:`) agents. Only needed if you repoint an
# agent at a bank-hosted service in agents.yaml.
AGENT_SERVICE_TOKEN=

# Path to the capability profile read by the feasibility agent. Ships the blank
# template; point at data/examples/hdfc_profile.md or your own real profile.
PARTNER_PROFILE_PATH=/app/data/partner_profile.md

# ── LLM provider (for in-process agents) ─────────────────────────────────────
# Provider: claude | openai | ainxt. Feasibility returns MOCK output when no key
# is set, so a fresh clone runs without credentials.
LLM_PROVIDER=claude
PARTNER_ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-6
PARTNER_OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
PARTNER_AINXT_API_KEY=
AINXT_BASE_URL=https://ainxt.npci.org.in/ainxt/v1/api
AINXT_MODEL=gpt-4o
