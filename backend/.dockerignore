# Local env must NOT be baked into the image — pydantic-settings reads
# /app/.env at runtime, and a stale baked copy silently shadows the
# values compose injects via env_file/environment (caused a Postgres-era
# crash when an old DATABASE_PATH lingered in the image).
.env

# Build/runtime noise that has no business in the image.
__pycache__/
*.pyc
data/*.db
.pytest_cache/
