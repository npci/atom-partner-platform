# ============================================================================
# Partner Backend — Production Dockerfile (Air-gapped / Nexus Repo)
#
# Uses repo.npci.org.in for all package downloads.
# No internet access required.
#
# Usage:
#   docker build -f Dockerfile.prod -t partner-backend:prod .
#
# Prerequisites on Nexus (repo.npci.org.in):
#   - Docker registry proxy: repo.npci.org.in/docker-hub/
#   - PyPI proxy:            repo.npci.org.in/pypi-proxy/simple/
# ============================================================================

FROM repo.npci.org.in/docker-hub/python:3.12-slim

WORKDIR /app

# Python packages — use internal PyPI mirror
COPY requirements.txt .
RUN pip install --no-cache-dir \
    --index-url http://repo.npci.org.in/pypi-proxy/simple/ \
    --trusted-host repo.npci.org.in \
    -r requirements.txt

COPY . .

EXPOSE 8001
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8001"]
